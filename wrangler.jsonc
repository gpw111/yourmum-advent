{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourmum-advent",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yourmum",
      "database_id": "89ae1c07-c031-4156-9728-56a158e29d3c"
    }
  ]
}
