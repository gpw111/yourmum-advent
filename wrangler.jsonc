{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yourmum-advent",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
  // Once the D1 database exists, add:
  // ,"d1_databases": [{ "binding": "DB", "database_name": "yourmum-advent", "database_id": "<id>" }]
}
